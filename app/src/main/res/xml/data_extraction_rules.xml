<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-transfer rules for Android 12 and above. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
