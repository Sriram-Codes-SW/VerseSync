<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and below. -->
<full-backup-content>
    <!-- Trial counters and app-lock settings must not follow a backup to another install. -->
    <exclude domain="file" path="datastore" />
    <!-- Speech models are large and re-downloadable. -->
    <exclude domain="file" path="models" />
</full-backup-content>
